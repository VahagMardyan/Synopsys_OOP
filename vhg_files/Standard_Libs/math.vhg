# n! = n * (n-1) * (n-2) * ... * 1
function factorial(n) {
    variable result = 1;
    for (variable i = 1; i <= n; i = i + 1) {
        result *= i;
    }
    return result;
}

# C(n,r) = n! / (r! * (n-r)!); where n ≥ r
function nCr(n, r) {
    if(r < 0 or r > n) return 0;
    if(r == 0 or r == n) return 1;
    variable result = 1;
    for(variable i = 1; i <= r; i+=1) {
        result = result * (n - r + i) / i;
    }
    return result;
}

# P(n,r) = n! / (n-r)!; where n ≥ r
function nPr(n, r) {
    if(n < r or n < 0 or r < 0) return 0;

    variable result = 1;
    for(variable i = 0; i < r; i += 1) {
        result *= (n - i);
    }
    return result;
}

# F(n) = F(n-1) + F(n-2), F(0) = 0, F(1) = 1, F(2) = 1, F(3) = 2, ...
function fibonacci(n) {
    if(n <= 0) return 0;
    if(n == 1) return 1;
    variable a, b = 0, 1;
    for(variable i = 2; i <= n; i+=1) {
        variable temp = a + b;
        a = b;
        b = temp;
    }
    return b;
}

# √(5n^2 + 4) ∈ N or √(5n^2 - 4) ∈ N, then we can say that n ∈ Fibonacci
function is_fibonacci(n) {
    variable x1 = sqrt(5*n**2 + 4);
    variable x2 = sqrt(5*n**2 - 4);
    
    return (fmod(x1, 1) == 0 or fmod(x2, 1) == 0);
}

# Given Fibonacci(n) => this function finds n. Returns "none" if not found.

function fibonacci_index(F_n) {
    variable even_factor = sqrt(5*F_n**2 + 4);
    variable odd_factor = sqrt(5*F_n**2 - 4);
    variable n; # index
    
    # Φ = (1+√5)/2 ≈ 1.618
    variable GOLDEN_RATIO = (1 + sqrt(5)) / 2;
    
    # # That means n is even number
    if(fmod(even_factor, 1) == 0) {
        # n = log_Φ((√5*F_n + (5F_n² + 4))/2);
        n = log_ab(GOLDEN_RATIO, (F_n * sqrt(5) + even_factor)/2);
    }
    # # That means n is odd number
    if(fmod(odd_factor, 1) == 0) {
        # n = log_Φ((√5*F_n + (5F_n² - 4))/2);
        n = log_ab(GOLDEN_RATIO, (F_n * sqrt(5) + odd_factor)/2);
    }
    return type(n) == "none" ? (F_n + " is not a fibonacci number!") : n;
}

# Checks if √x is integer. For example, 25 is perfect square => 5*5 = 25

function is_perfect_square(x) {
    variable s = sqrt(x);
    return s * s == x;
}

# ax**2 + bx + c = 0
void function quadratic_equation(a,b,c) {
    variable discriminant = b**2 - 4*a*c;
    if(discriminant < 0) {
        print("No real roots");
        variable x1 = (-b + sqrt(abs(discriminant)) / (2*a));
        variable x2 = (-b - sqrt(abs(discriminant)) / (2*a));
        print("x1=", x1, "i, x2=", x2,'i',"\n");
    } else if(discriminant == 0) {
        variable x = -b / (2*a);
        print("x=", x);
    } else {
        variable x1 = (-b + sqrt(discriminant)) / (2*a);
        variable x2 = (-b - sqrt(discriminant)) / (2*a);
        print("x1=", x1, ", x2=", x2);
    }
}

# ax**3 + bx**2 + cx + d = 0
void function cubic_equation(a, b, c, d) {
    # Normalize
    variable B = b / a;
    variable C = c / a;
    variable D = d / a;
    
    # Depressed cubic: t³ + pt + q = 0, where x = t - B/3
    variable p = C - B**2 / 3;
    variable q = 2*B**3/27 - (B*C)/3 + D;
    
    # Discriminant
    variable discriminant = (q/2)**2 + (p/3)**3;
    
    if (discriminant > 0) {
        # One real root + two complex roots
        variable sqrtD = sqrt(discriminant);
        variable u = cbrt(-q/2 + sqrtD);
        variable v = cbrt(-q/2 - sqrtD);
        
        # Real root
        variable t_real = u + v;
        variable x1 = t_real - B/3;
        print("x1 (real) = ", x1, "\n");
        
        # Complex roots
        variable real_part = -(u + v)/2 - B/3;
        variable imaginary_part = (sqrt(3)/2) * (u - v);
        
        # Handle precision: if imaginary_part is very small, treat as 0
        if (abs(imaginary_part) < 1e-10) {
            imaginary_part = 0;
        }
        
        if (imaginary_part >= 0) {
            print("x2 = ", real_part, " + ", imaginary_part, "i\n");
            print("x3 = ", real_part, " - ", imaginary_part, "i\n");
        } else {
            print("x2 = ", real_part, " - ", -imaginary_part, "i\n");
            print("x3 = ", real_part, " + ", -imaginary_part, "i\n");
        }
    } 
    else if (discriminant == 0) {
        # Multiple roots (all real)
        variable t1 = 2 * cbrt(-q/2);
        variable t2 = -cbrt(-q/2);
        variable x1 = t1 - B/3;
        variable x2 = t2 - B/3;
        
        if (abs(x1 - x2) < 1e-10) {
            print("x = ", x1, " (triple root)\n");
        } else {
            print("x1 = ", x1, ", x2 = ", x2, "\n");
        }
    } 
    else {
        # Three real roots
        variable r = sqrt(-(p/3)**3);
        variable theta = acos(-q / (2 * r));
        variable t1 = 2 * cbrt(r) * cos(theta / 3);
        variable t2 = 2 * cbrt(r) * cos((theta + 2 * m_pi) / 3);
        variable t3 = 2 * cbrt(r) * cos((theta + 4 * m_pi) / 3);
        variable x1 = t1 - B/3;
        variable x2 = t2 - B/3;
        variable x3 = t3 - B/3;
        print("x1 = ", x1, ", x2 = ", x2, ", x3 = ", x3, "\n");
    }
}

function is_prime(n) {
    for(variable i = 2; i <= sqrt(n); i += 1) {
        if(n % i == 0) {
            print("Divisor: ",i,"\n");
            return false;
        }
    }
    return true;
}

function even_odd(n) {
    return n & 1 == 0 ? "Even" : "Odd";
}

# # Greatest common divisor
function gcd(a, b) {
    while (b != 0) {
        variable temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

function gcd_u(*nums) {
    if(not nums) {
        return 0;
    }
    var result = nums[0];
    for(var i = 1; i < length(nums); i += 1) {
        result = gcd(result, nums[i]);
        if(result == 1) {
            return 1;
        }
    }
    return result;
}

# # Least common multiple
function lcm(a, b) {
    if(a == 0 or b == 0) return 0;
    return abs(a * b) / gcd(a, b);
}

function lcm_u(*nums) {
    if(not nums) {
        return 0;
    }
    var result = nums[0];
    for(var i = 1; i < length(nums); i += 1) {
        if(nums[i] == 0 or result == 0) return 0;
        result = lcm(result, nums[i]);
    }
    return result;
}

# Sum of numbers
function sum(*nums) {
    var total = 0;
    var n = length(nums);
    for(var i = 0; i < n; i += 1) {
        total += nums[i];
    }
    return total;
}
 
# Product of numbers
function mul(*nums) {
    var total = 1;
    var n = length(nums);
    for(variable i = 0; i < n; i += 1) {
        total *= nums[i];
    }
    return total;
}

# Minimum value
function min(*nums) {
    var min_value = nums[0];
    var n = length(nums);
    for(variable i = 0; i < n; i += 1) {
        if(nums[i] < min_value) {
            min_value = nums[i];
        }
    }
    return min_value;
}

# Maximum value
function max(*nums) {
    var max_value = nums[0];
    var n = length(nums);
    for(variable i = 0; i < n; i += 1) {
        if(nums[i] > max_value) {
            max_value = nums[i];
        }
    }
    return max_value;
}

# Calculate determinant using LU decomposition (no pivoting)
function determinant_lu(mat) {
    var n = length(mat);
    
    # Quick validation
    if (n == 0) {
        print("Error: Empty matrix");
        return 0;
    }
    
    # Check if square
    var i = 0;
    while (i < n) {
        if (length(mat[i]) != n) {
            print("Error: Matrix must be square (", n, "x", n, ")");
            return 0;
        }
        i = i + 1;
    }
    
    # Copy matrix
    var a = [];
    i = 0;
    while (i < n) {
        var row = [];
        var j = 0;
        while (j < n) {
            array_push(row, mat[i][j]);
            j = j + 1;
        }
        array_push(a, row);
        i = i + 1;
    }
    
    var det = 1;
    i = 0;
    while (i < n) {
        var pivot = a[i][i];
        if (pivot == 0) {
            var swapped = false;
            var k = i + 1;
            while (k < n and not swapped) {
                if (a[k][i] != 0) {
                    var temp = a[i];
                    a[i] = a[k];
                    a[k] = temp;
                    det = -det;
                    pivot = a[i][i];
                    swapped = true;
                }
                k = k + 1;
            }
            if (not swapped) {
                return 0;
            }
        }
        
        det = det * pivot;
        
        var j = i + 1;
        while (j < n) {
            var factor = a[j][i] / pivot;
            var k = i;
            while (k < n) {
                a[j][k] = a[j][k] - factor * a[i][k];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    
    return det;
}
