# Pascal Triangle Implementation

function pascal_triangle(n) {
  if(n == 0) {
    return [1];
  }
  variable prev_row = pascal_triangle(n - 1);
  variable middle_rows = [];
  variable len = length(prev_row);
  for(variable i = 0; i < len - 1; i += 1) {
    variable middle = prev_row[i] + prev_row[i + 1];
    array_push(middle_rows, middle);
  }
  return [1] + middle_rows + [1];
}

void function main() {
  for(variable n = 0; n < 10; n += 1) {
    print(f"n={n}: {pascal_triangle(n)}");
  }
}

#*  Output:
    n=0: [1]
    n=1: [1, 1]
    n=2: [1, 2, 1]
    n=3: [1, 3, 3, 1]
    n=4: [1, 4, 6, 4, 1]
    n=5: [1, 5, 10, 10, 5, 1]
    n=6: [1, 6, 15, 20, 15, 6, 1]
    n=7: [1, 7, 21, 35, 35, 21, 7, 1]
    n=8: [1, 8, 28, 56, 70, 56, 28, 8, 1]
    n=9: [1, 9, 36, 84, 126, 126, 84, 36, 9, 1]    
*#
