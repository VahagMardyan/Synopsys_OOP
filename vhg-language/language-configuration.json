{
    "comments": {
        "lineComment": {
            "comment" : "#",
            "noIndent" : false
        },
        "blockComment": ["#*", "*#"]
    },
    "brackets": [
        ["{", "}"],
        ["(", ")"],
        ["[", "]"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "\"", "close": "\"" },
        { "open": "'", "close": "'" },
        { "open": "f\"", "close": "\"" },
        { "open": "f'", "close": "'" },
        { "open": "F\"", "close": "\"" },
        { "open": "F'", "close": "'" },
        { "open": "#*", "close": "*#" },
    ]
}